{
  "name": "playwright-user-management-automation",
  "version": "1.0.0",
  "description": "This project implements automated end-to-end testing of a web application's user management functionality using **Playwright, TypeScript and the Page Object Model (POM)** design pattern.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:debug": "playwright test --debug",
    "report:playwright": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZuzekaL/playwright-user-management-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ZuzekaL/playwright-user-management-automation/issues"
  },
  "homepage": "https://github.com/ZuzekaL/playwright-user-management-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
